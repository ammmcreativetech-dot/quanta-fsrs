{
  "name": "quanta-fsrs",
  "version": "1.0.4",
  "description": "FSRS-inspired flashcard scheduling utilities for TypeScript, with card state, recall estimates and due-card helpers. No runtime dependencies.",
  "keywords": [
    "fsrs",
    "spaced-repetition",
    "flashcards",
    "typescript",
    "scheduler"
  ],
  "homepage": "https://github.com/ammmcreativetech-dot/quanta-fsrs#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ammmcreativetech-dot/quanta-fsrs"
  },
  "bugs": {
    "url": "https://github.com/ammmcreativetech-dot/quanta-fsrs/issues"
  },
  "author": "Quanta Team <ammm.creativetech@gmail.com> (https://quanta-study.de)",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run test:package",
    "test:package": "npm run build && node scripts/check-package.cjs"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
